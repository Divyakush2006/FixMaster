# ============================================================================
# FIX_MASTER API configuration. Copy to .env and adjust.
# Only DATABASE_URL and JWT_SECRET are required; everything else has a default.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=5000
# development | production | test. In production the API refuses to start
# with the example JWT_SECRET, a short secret, or no CORS_ORIGIN.
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Never commit a real connection string: .env is git-ignored, this file is not.
# Local:  postgresql://<user>:<password>@localhost:5432/fix_master_db
# Neon:   postgresql://<user>:<password>@<endpoint>.neon.tech/fix_master_db?sslmode=require
DATABASE_URL="postgresql://postgres:<your-local-postgres-password>@localhost:5432/fix_master_db"
# TLS is turned on automatically for sslmode=require / Neon URLs, or by
# DB_SSL=true. Certificates are verified; set DB_SSL_REJECT_UNAUTHORIZED=false
# only if your provider's chain can't be validated by Node.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# Pool tuning (defaults shown)
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000

# --- Auth -------------------------------------------------------------------
# Signing key for session tokens. Anyone who knows it can forge a token for
# any user, so it is never committed. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty in local development, the API uses a random secret for each run
# (sessions end on restart). Production refuses to start without a strong one.
JWT_SECRET=""
JWT_EXPIRES_IN="24h"
# Administrator sessions (the /admin sign-in) are shorter-lived.
JWT_ADMIN_EXPIRES_IN="8h"
# Per-account lockout: after this many consecutive wrong passwords (from any
# IP) the account refuses sign-in for LOGIN_LOCKOUT_MINUTES. An administrator
# can unlock it sooner (Users & access) or reset the password.
# LOGIN_LOCKOUT_THRESHOLD=10
# LOGIN_LOCKOUT_MINUTES=15

# --- HTTP -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Required in
# production. Not needed when the web app is served from the same origin
# (the docker-compose setup proxies /api through nginx).
# CORS_ORIGIN="https://fixmaster.example.com"
CORS_ORIGIN=

# Number of reverse proxies in front of the API (e.g. 1 behind nginx or a
# load balancer). Without it every client appears to come from the proxy's
# IP and they all share ONE rate-limit bucket.
TRUST_PROXY=

# Request log format: 'json' for log aggregation (default in production).
# LOG_FORMAT=json

# --- Rate limits (defaults shown) ----------------------------------------------
# A campus reaches the API through a few NAT addresses, so limits are keyed
# per account wherever one is known; per-IP limits are coarse ceilings.
# RATE_LIMIT_AUTH_MAX=20            # failed sign-ins per account per IP, 15 min (student/staff)
# RATE_LIMIT_AUTH_IP_MAX=200        # failed sign-ins per IP across all accounts, 15 min
# RATE_LIMIT_ADMIN_AUTH_MAX=10      # failed admin sign-ins per account per IP, 15 min
# RATE_LIMIT_ADMIN_AUTH_IP_MAX=30   # failed admin sign-ins per IP, 15 min
# RATE_LIMIT_REGISTER_MAX=10        # registrations per IP per hour
# RATE_LIMIT_MAX=300                # requests per signed-in user per minute
# RATE_LIMIT_ANON_MAX=1200          # anonymous requests per IP per minute

# --- Student sign-up ----------------------------------------------------------------
# Only these mail domains may self-register (comma-separated, exact match on
# the part after "@"). New students confirm the address with an emailed
# 6-digit code, then complete their profile before using the app.
# STUDENT_EMAIL_DOMAINS="vitstudent.ac.in"
# STUDENT_REG_NO_PATTERN="^[0-9]{2}[A-Z]{3}[0-9]{4}$"   # e.g. 21BCE0843
# EMAIL_CODE_TTL_MINUTES=15
# EMAIL_CODE_MAX_ATTEMPTS=5
# EMAIL_CODE_RESEND_SECONDS=60
# RATE_LIMIT_VERIFY_MAX=10          # code attempts per account per 15 min
# RATE_LIMIT_VERIFY_IP_MAX=100      # code attempts per IP per 15 min
# RATE_LIMIT_RESEND_IP_MAX=30       # code resends per IP per 15 min

# --- Email (sign-up codes and password reset) ----------------------------------------
# Sign-up emails a verification code; "Forgot password?" emails a one-time
# link. Without SMTP_URL both switch themselves off in production (the pages
# then point people to the hostel office); in development the message is
# printed to the API console instead. Keep SMTP_URL out of git.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="FixMaster <no-reply@example.com>"
# Public address of the web app, used to build the link (defaults to the
# first CORS_ORIGIN).
# APP_URL="https://fixmaster.example.com"
# RATE_LIMIT_FORGOT_MAX=3           # reset emails per account per hour
# RATE_LIMIT_FORGOT_IP_MAX=60       # reset requests per IP per hour

# --- Ticket lifecycle ----------------------------------------------------------
# A ticket whose work was marked done but that no resident confirmed or
# rejected is closed automatically after this many hours (closure reason
# AUTO_CONFIRMED). A background sweep checks every VERIFICATION_SWEEP_MINUTES;
# it is safe to run several API instances.
# VERIFICATION_AUTO_CLOSE_HOURS=72
# VERIFICATION_SWEEP_MINUTES=15
# When this many people have reported the same common-area fault, its
# priority goes up one level (never beyond High).
# COMMON_AREA_PRIORITY_BUMP_AT=5

# --- Performance ----------------------------------------------------------------
# Password hashing (bcrypt, cost 12) runs on libuv's thread pool, so sign-in
# bursts don't stall other requests. The pool has 4 threads by default; on a
# host with more cores, raising it lets more sign-ins hash in parallel.
# UV_THREADPOOL_SIZE=4

# --- Tests ------------------------------------------------------------------
# npm test rebuilds this database from scratch. Its name must contain "test".
# Defaults to DATABASE_URL with the database name fix_master_test.
# TEST_DATABASE_URL="postgresql://postgres:<your-local-postgres-password>@localhost:5432/fix_master_test"

# --- AI (optional) ------------------------------------------------------------------
# Every AI feature works without AI too (keyword matcher, rule-based
# dispatch, template briefings). Set any of these keys to switch it on; each
# task tries its providers in order and skips the ones without a key. Free-tier
# limits change often: confirm them in each provider's console.
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
#
# Provider chains per task (provider:model, first that answers wins):
# AI_ROUTE_INTAKE="groq:openai/gpt-oss-20b,gemini:gemini-flash-lite-latest,openrouter:openai/gpt-oss-20b:free"
# AI_ROUTE_FEEDBACK_TAGS="gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-20b"
# AI_ROUTE_BRIEFING="gemini:gemini-flash-latest,groq:openai/gpt-oss-120b,openrouter:openai/gpt-oss-20b:free"
# AI_ROUTE_ASK="groq:openai/gpt-oss-120b,gemini:gemini-flash-latest"
# AI_TIMEOUT_MS=8000
# Attempts per provider per day across all API servers (keep under the free tier):
# AI_DAILY_LIMIT_GROQ=12000
# AI_DAILY_LIMIT_GEMINI=400
# AI_DAILY_LIMIT_OPENROUTER=45
# Assistant uses per student per day, and per minute:
# AI_USER_DAILY_LIMIT=40
# RATE_LIMIT_ASSISTANT_MAX=10
#
# Provider addresses can be overridden, e.g. to go through a company gateway:
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
#
# Review-comment tagging runs this often (minutes), and data downloads or
# erasure requests are limited per person per hour:
# FEEDBACK_TAG_MINUTES=60
# RATE_LIMIT_PRIVACY_MAX=10
#
# Local open-source models, CPU only (scripts/local-ai/README.md):
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# LOCAL_AI_BASE_URL="http://127.0.0.1:8080/v1"   # llama.cpp / vLLM / LM Studio
# LOCAL_AI_NUM_GPU=0                              # 0 = never use a GPU
# LOCAL_AI_TIMEOUT_MS=45000

# --- Operating the service ----------------------------------------------------------
# Metrics for Prometheus or a cloud monitor at GET /api/metrics. In production
# the endpoint exists only when a token is set; send it as "Authorization: Bearer <token>".
# METRICS_TOKEN=""
# A chat webhook (Slack, Teams, Google Chat, Mattermost) told about unexpected
# server errors: each distinct failure once, then at most every 5 minutes.
# ERROR_WEBHOOK_URL=""
# ERROR_ALERT_REPEAT_MINUTES=5
# Manager dashboards reuse one computation for this many milliseconds (0 = off).
# DASHBOARD_CACHE_MS=15000
# How long records are kept, in days (0 = keep). Defaults shown.
# RETENTION_AI_CALL_DAYS=90
# RETENTION_BRIEFING_DAYS=90
# RETENTION_VERIFICATION_DAYS=30
# RETENTION_UNVERIFIED_DAYS=14
# RETENTION_AUDIT_DAYS=0

# --- University single sign-on (OpenID Connect) --------------------------------------
# Off until the first three are set. See docs/OPERATIONS.md, "Single sign-on".
# OIDC_ISSUER="https://accounts.google.com"     # Microsoft: https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="https://fixmaster.example.edu/api/auth/sso/callback"   # default: <APP_URL>/api/auth/sso/callback
# OIDC_LABEL="your VIT account"                   # the button reads "Sign in with <this>"
# OIDC_ALLOWED_DOMAINS="vitstudent.ac.in"         # default: STUDENT_EMAIL_DOMAINS
# OIDC_DOMAIN_HINT="vitstudent.ac.in"             # optional: pre-selects the university at the provider
