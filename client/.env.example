# Base URL of the FIX_MASTER API as seen from the browser.
# Leave unset to use the same-origin path /api, which is what both the Vite dev
# server (proxy in vite.config.ts) and the production nginx image serve.
# Only set this if the API is deployed on a different origin, e.g.:
# VITE_API_BASE_URL=https://api.fixmaster.example.com/api
